PORT=3000
CHURCHOS_DB_PROVIDER=sqlite
CHURCHOS_DB_DIR=./db
CHURCHOS_DB_FILE=./db/churchos.sqlite
CHURCHOS_UPLOAD_DIR=./public/uploads
CHURCHOS_SESSION_SECRET=replace-with-a-long-random-secret-before-deployment

# Optional deployment admin bootstrap
CHURCHOS_ADMIN_EMAIL=
CHURCHOS_ADMIN_PASSWORD=
CHURCHOS_ADMIN_NAME=

# Required only when CHURCHOS_DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
